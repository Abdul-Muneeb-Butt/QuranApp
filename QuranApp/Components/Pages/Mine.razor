@page "/mine"
@inject QuranApp.Services.SessionService SessionService
@inject NavigationManager Navigation
@rendermode InteractiveServer

@if (!SessionService.IsLoggedIn)
{
    Navigation.NavigateTo("/login");
}
else
{
    <div style="min-height:100vh; background:#f5f5f5; padding-bottom:80px;">

        @* Header *@
        <div style="background:#2e7d52; padding:30px 20px; text-align:center;">
            <div style="font-size:60px;">👤</div>
            <h2 style="color:white; margin:10px 0 5px 0;">
                @SessionService.CurrentUser?.FullName
            </h2>
            <p style="color:#b2dfdb; font-size:14px;">
                @SessionService.CurrentUser?.Email
            </p>
            <p style="color:#b2dfdb; font-size:12px;">
                Member since @SessionService.CurrentUser?.CreatedAt.ToString("MMMM yyyy")
            </p>
        </div>

        @* Menu Items *@
        <div style="padding:20px;">

            <a href="/bookmarks"
                   style="text-decoration:none;">
                <div style="background:white; border-radius:12px;
                    padding:15px 20px; margin-bottom:10px;
                    box-shadow:0 2px 8px rgba(0,0,0,0.08);
                    display:flex; align-items:center; gap:15px;">
                    <span style="font-size:24px;">🔖</span>
                    <span style="font-size:16px; color:#333;">My Bookmarks</span>
                    <span style="margin-left:auto; color:#888;">›</span>
                </div>
            </a>

            <a href="/quran"
                   style="text-decoration:none;">
                <div style="background:white; border-radius:12px;
                    padding:15px 20px; margin-bottom:10px;
                    box-shadow:0 2px 8px rgba(0,0,0,0.08);
                    display:flex; align-items:center; gap:15px;">
                    <span style="font-size:24px;">📖</span>
                    <span style="font-size:16px; color:#333;">Quran Reader</span>
                    <span style="margin-left:auto; color:#888;">›</span>
                </div>
            </a>

            <a href="/prayer"
                   style="text-decoration:none;">
                <div style="background:white; border-radius:12px;
                    padding:15px 20px; margin-bottom:10px;
                    box-shadow:0 2px 8px rgba(0,0,0,0.08);
                    display:flex; align-items:center; gap:15px;">
                    <span style="font-size:24px;">🕐</span>
                    <span style="font-size:16px; color:#333;">Prayer Times</span>
                    <span style="margin-left:auto; color:#888;">›</span>
                </div>
            </a>

            @* Logout Button *@
            <div style="margin-top:30px;">
                <button @onclick="HandleLogout"
                        style="width:100%; padding:14px; background:#e53935;
                    color:white; border:none; border-radius:8px;
                    font-size:16px; font-weight:bold; cursor:pointer;">
                    Logout
                </button>
            </div>

        </div>
    </div>
}

@code {
    private void HandleLogout()
    {
        SessionService.Logout();
        Navigation.NavigateTo("/login");
    }
}