@page "/prayer"
@inject QuranApp.Services.PrayerService PrayerService
@rendermode InteractiveServer

<div class="quran-header">
    🕌 Prayer Times
</div>

@if (prayerTimes == null)
{
    <div style="padding:15px; background:#f5f0e8;">
        <input @bind="searchCity"
               @bind:event="oninput"
               placeholder="Search city..."
               style="width:100%; padding:10px; border:1px solid #c8a96e;
        border-radius:25px; font-size:16px; box-sizing:border-box;" />
    </div>

    <div style="padding:10px 15px;">
        <p style="color:#888; font-size:14px; margin-bottom:10px;">🔥 Popular Cities</p>
        @foreach (var c in FilteredCities)
        {
            <div @onclick="() => SelectCity(c)"
                 style="padding:15px; border-bottom:1px solid #eee;
                cursor:pointer; font-size:16px; color:#333;">
                📍 @c, Pakistan
            </div>
        }
    </div>

    @if (isLoading)
    {
        <p style="text-align:center; padding:20px;">Loading...</p>
    }
    @if (hasError)
    {
        <p style="text-align:center; color:red;">City not found. Try again.</p>
    }
}
else
{
    <div style="padding:10px 15px; background:#e8f5e9;">
        <span style="color:#2e7d52; cursor:pointer;" @onclick="GoBack">
            ← Back to Cities
        </span>
    </div>

    <div style="background:#2e7d52; padding:15px; text-align:center;
        position:relative; overflow:hidden; min-height:150px;">

        <img src="/images/mosque.png"
             style="position:absolute; bottom:0; left:0; width:100%;
        opacity:0.2; height:120px; object-fit:cover;" />

        <div style="color:white; font-size:16px; margin-bottom:10px;">
            📍 @city, Pakistan
        </div>

        <div style="display:flex; justify-content:center; gap:0;
            background:white; border-radius:10px;
            margin:0 20px; overflow:hidden; position:relative; z-index:1;">

            <div style="flex:1; padding:15px; border-right:1px solid #eee;">
                <div style="color:#2e7d52; font-size:13px;">
                    @DateTime.Now.ToString("dddd")
                </div>
                <div style="color:#2e7d52; font-size:36px; font-weight:bold;">
                    @DateTime.Now.Day
                </div>
                <div style="color:#2e7d52; font-size:13px;">
                    @DateTime.Now.ToString("MM/yyyy")
                </div>
            </div>

            <div style="flex:1; padding:15px;">
                <div style="color:#2e7d52; font-size:13px;">
                    @hijriWeekday
                </div>
                <div style="color:#2e7d52; font-size:36px; font-weight:bold;">
                    @hijriDay
                </div>
                <div style="color:#2e7d52; font-size:13px;">
                    @hijriMonth @hijriYear
                </div>
            </div>
        </div>
    </div>

    <div style="padding:12px 15px; background:#f9f9f9; border-bottom:1px solid #eee;">
        <div style="display:flex; justify-content:space-between; margin-bottom:6px;">
            <span style="color:#333; font-size:14px;">Next: <b>@nextPrayerName</b></span>
            <span style="color:#333; font-size:14px;">@FormatTime(nextPrayerTime)</span>
        </div>
        <div style="background:#eee; border-radius:10px; height:6px; overflow:hidden; margin-bottom:5px;">
            <div style="background:#f4c430; height:100%; border-radius:10px;
                width:@(progressPercent.ToString("F0"))%;">
            </div>
        </div>
        <div style="text-align:center; color:#f4c430; font-size:13px; font-weight:bold;">
            ⏱ @timeRemaining
        </div>
    </div>

    @foreach (var prayer in GetPrayers())
    {
        <div style="display:flex; align-items:center; border-bottom:1px solid #eee;
            @(prayer.Name == nextPrayerName ? "background:#fffde7;" : "")">
            <div style="background:#2e7d52; color:white;
                width:120px; padding:18px 10px;
                text-align:center; font-size:16px; font-weight:bold;">
                @prayer.Time
            </div>
            <div style="padding:18px 20px; font-size:18px; color:#333; flex:1;">
                @prayer.Icon @prayer.Name
            </div>
        </div>
    }
}

@code {
    private string city = "";
    private string country = "PK";
    private QuranApp.Services.PrayerTimes? prayerTimes;
    private bool isLoading = false;
    private bool hasError = false;
    private string hijriDay = "";
    private string hijriWeekday = "";
    private string hijriMonth = "";
    private string hijriYear = "";
    private string nextPrayerName = "";
    private string nextPrayerTime = "";
    private double progressPercent = 0;
    private string timeRemaining = "";

    private List<string> pakistanCities = new()
    {
        "Lahore", "Karachi", "Islamabad", "Rawalpindi", "Faisalabad",
        "Multan", "Peshawar", "Quetta", "Hyderabad", "Gujranwala",
        "Sialkot", "Gujrat", "Bahawalpur", "Sargodha", "Sukkur",
        "Larkana", "Sheikhupura", "Rahim Yar Khan", "Jhang", "Mardan",
        "Abbottabad", "Muzaffarabad", "Gilgit", "Mirpur", "Nawabshah"
    };

    private string searchCity = "";

    private List<string> FilteredCities => pakistanCities
        .Where(c => c.Contains(searchCity, StringComparison.OrdinalIgnoreCase))
        .ToList();

    private class PrayerItem
    {
        public string Name { get; set; } = "";
        public string Time { get; set; } = "";
        public string Icon { get; set; } = "";
    }

    private string FormatTime(string time24)
    {
        if (TimeSpan.TryParse(time24, out var t))
        {
            var dt = DateTime.Today.Add(t);
            return dt.ToString("h:mm tt");
        }
        return time24;
    }

    private List<PrayerItem> GetPrayers()
    {
        if (prayerTimes == null) return new();
        return new List<PrayerItem>
        {
            new PrayerItem { Name = "Fajr", Time = FormatTime(prayerTimes.Fajr), Icon = "🌙" },
            new PrayerItem { Name = "Sunrise", Time = FormatTime(prayerTimes.Sunrise), Icon = "🌅" },
            new PrayerItem { Name = "Dhuhr", Time = FormatTime(prayerTimes.Dhuhr), Icon = "☀️" },
            new PrayerItem { Name = "Asr", Time = FormatTime(prayerTimes.Asr), Icon = "🌤️" },
            new PrayerItem { Name = "Maghrib", Time = FormatTime(prayerTimes.Maghrib), Icon = "🌇" },
            new PrayerItem { Name = "Isha", Time = FormatTime(prayerTimes.Isha), Icon = "🌙" }
        };
    }

    protected override Task OnInitializedAsync()
    {
        return Task.CompletedTask;
    }

    private async Task SelectCity(string selectedCity)
    {
        city = selectedCity;
        country = "PK";
        await LoadPrayerTimes();
    }

    private void GoBack()
    {
        prayerTimes = null;
        searchCity = "";
        nextPrayerName = "";
        nextPrayerTime = "";
        progressPercent = 0;
    }

    private async Task LoadPrayerTimes()
    {
        isLoading = true;
        hasError = false;
        prayerTimes = null;

        try
        {
            var result = await PrayerService.GetPrayerTimesAsync(city, country);
            if (result != null)
            {
                prayerTimes = result;
                CalculateNextPrayer();
            }
            else
            {
                hasError = true;
            }

            var hijri = await PrayerService.GetHijriDateAsync();
            if (hijri != null)
            {
                hijriDay = hijri.Day;
                hijriWeekday = hijri.Weekday?.En ?? "";
                hijriMonth = hijri.Month?.En ?? "";
                hijriYear = hijri.Year;
            }
        }
        catch
        {
            hasError = true;
        }

        isLoading = false;
    }

    private void CalculateNextPrayer()
{
    var now = DateTime.Now.TimeOfDay;

    var prayerList = new[]
    {
        new { Name = "Fajr", Time = prayerTimes!.Fajr },
        new { Name = "Sunrise", Time = prayerTimes.Sunrise },
        new { Name = "Dhuhr", Time = prayerTimes.Dhuhr },
        new { Name = "Asr", Time = prayerTimes.Asr },
        new { Name = "Maghrib", Time = prayerTimes.Maghrib },
        new { Name = "Isha", Time = prayerTimes.Isha }
    };

    foreach (var prayer in prayerList)
    {
        if (TimeSpan.TryParse(prayer.Time, out var prayerTime))
        {
            if (now < prayerTime)
            {
                nextPrayerName = prayer.Name;
                nextPrayerTime = prayer.Time;
                var remaining = prayerTime - now;
                timeRemaining = $"{(int)remaining.TotalHours}h {remaining.Minutes}m remaining";
                var totalMinutes = (prayerTime - now).TotalMinutes;
                progressPercent = 100 - (totalMinutes / 1440 * 100);
                return;
            }
        }
    }

    nextPrayerName = "Fajr";
    nextPrayerTime = prayerTimes!.Fajr;
    timeRemaining = "Tomorrow";
    progressPercent = 90;
}
    }

