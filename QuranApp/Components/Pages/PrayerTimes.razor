@page "/prayertime"
@inject QuranApp.Services.PrayerService PrayerService
@rendermode InteractiveServer
<div class="quran-header">
    🕌 Prayer Times
</div>

@if (prayerTimes == null)
{
    <div style="padding:15px; background:#f5f0e8;">
        <input @bind="searchCity"
               @bind:event="oninput"
               placeholder="Search city..."
               style="width:100%; padding:10px; border:1px solid #c8a96e;
                      border-radius:25px; font-size:16px; box-sizing:border-box;" />
    </div>

@code{
    private List<string> pakistanCities = new()
{
    "Lahore", "Karachi", "Islamabad", "Rawalpindi", "Faisalabad",
    "Multan", "Peshawar", "Quetta", "Hyderabad", "Gujranwala",
    "Sialkot", "Gujrat", "Bahawalpur", "Sargodha", "Sukkur",
    "Larkana", "Sheikhupura", "Rahim Yar Khan", "Jhang", "Mardan",
    "Abbottabad", "Muzaffarabad", "Gilgit", "Mirpur", "Nawabshah"
};

    private string searchCity = "";

    private List<string> FilteredCities => pakistanCities
    .Where(c => c.Contains(searchCity, StringComparison.OrdinalIgnoreCase))
    .ToList();
}
