@page "/prayertime"
@inject QuranApp.Services.PrayerService PrayerService
@rendermode InteractiveServer
<div class="quran-container">
    <div class="quran-header">
        🕌 Prayer Times
    </div>

    <div style="padding:15px; background:#f5f0e8;">
        <div style="display:flex; gap:10px;">
            <input @bind="city"
                   placeholder="Enter City (e.g. Lahore)"
                   style="flex:1; padding:8px; border:1px solid #c8a96e;
            border-radius:5px; font-size:16px;" />
            <input @bind="country"
                   placeholder="Country (e.g. PK)"
                   style="width:80px; padding:8px; border:1px solid #c8a96e;
            border-radius:5px; font-size:16px;" />
            <button @onclick="LoadPrayerTimes"
                    style="background:#2e7d52; color:white; border:none;
                padding:8px 15px; border-radius:5px; cursor:pointer;">
                Search
            </button>
        </div>
    </div>

</div>
@code{
