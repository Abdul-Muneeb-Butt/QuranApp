    width:600px; height:600px; border-radius:50%;
    background:rgba(46,125,82,0.08);"></div>
    <div style="position:absolute; right:50px; top:50%; transform:translateY(-50%);
    width:400px; height:400px; border-radius:50%;
    background:rgba(46,125,82,0.06);"></div>

    @* Left Content *@
