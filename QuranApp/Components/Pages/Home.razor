            </a>
            <a href="/prayer" style="text-decoration:none; color:#444;
                font-size:15px; font-weight:500;">
                Prayer
            </a>
            <a href="/qibla" style="text-decoration:none; color:#444;
                font-size:15px; font-weight:500;">
