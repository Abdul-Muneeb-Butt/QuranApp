@* Hero Section *@
<div style="margin-top:65px; background:linear-gradient(135deg, #f0faf4, #e8f5ee);
    min-height:85vh; display:flex; align-items:center;
    padding:0 80px; position:relative; overflow:hidden;">
    <div style="position:absolute; right:-100px; top:50%;
    transform:translateY(-50%); width:600px; height:600px;
    border-radius:50%; background:rgba(46,125,82,0.08);"></div>
    <div style="position:absolute; right:50px; top:50%;
    transform:translateY(-50%); width:400px; height:400px;
    border-radius:50%; background:rgba(46,125,82,0.06);"></div>

    <div style="flex:1; z-index:1;">
        <div style="display:flex; align-items:center; gap:8px; margin-bottom:20px;">
            <span style="color:#2e7d52; font-size:16px;">📍</span>
            <select @onchange="ChangeCity"
                    style="background:transparent; color:#2e7d52; border:none;
                font-size:16px; font-weight:600; cursor:pointer;
                outline:none;">
                <option value="Islamabad">Islamabad</option>
                <option value="Karachi">Karachi</option>
                <option value="Lahore">Lahore</option>
                <option value="Peshawar">Peshawar</option>
                <option value="Quetta">Quetta</option>
                <option value="Multan">Multan</option>
                <option value="Faisalabad">Faisalabad</option>
                <option value="Rawalpindi">Rawalpindi</option>
                <option value="Kharian">Kharian</option>
                <option value="Gujranwala">Gujranwala</option>
                <option value="Sialkot">Sialkot</option>
                <option value="Dubai">Dubai</option>
                <option value="London">London</option>
                <option value="New York">New York</option>
            </select>
        </div>

        <p style="color:#888; font-size:18px; margin:0 0 10px 0;">
            Your Complete Islamic Companion
        </p>

        <h1 style="font-size:58px; font-weight:900; color:#1a1a1a;
            margin:0 0 20px 0; line-height:1.1;">
            Al-Quran<br />
            <span style="color:#2e7d52;">Web App</span>
        </h1>

        @if (prayerTimes != null)
        {
            <div style="background:white; border-radius:16px; padding:20px 25px;
                box-shadow:0 4px 20px rgba(0,0,0,0.08);
                display:inline-flex; align-items:center; gap:20px;
                margin-bottom:30px;">
                <div>
                    <div style="color:#888; font-size:13px;">Next Prayer</div>
                    <div style="color:#2e7d52; font-size:24px; font-weight:800;">
                        @currentPrayer
                    </div>
                </div>
                <div style="width:1px; height:40px; background:#e0e0e0;"></div>
                <div>
                    <div style="color:#888;font-size:13px;">Time</div>
                    <div style="color:#1a1a1a; font-size:24px; font-weight:800;">
                        @nextPrayerTime
                    </div>
                </div>
                <div style="width:1px; height:40px; background:#e0e0e0;"></div>
                <div>
                    <div style="color:#888; font-size:13px;">Remaining</div>
                    <div style="color:#e53935; font-size:20px; font-weight:700;">
                        @countdown
                    </div>
                </div>
            </div>
        }

        <div style="color:#888; font-size:14px; margin-bottom:30px;">
            @DateTime.Now.ToString("dddd, MMMM d yyyy")
            @if (hijriDate != null)
            {
                <span> — @hijriDate.Day @hijriDate.Month?.En @hijriDate.Year AH</span>
            }
        </div>

        <div style="display:flex; gap:15px;">
            <a href="/quran"
               style="background:#2e7d52; color:white; padding:14px 30px;
                border-radius:30px; text-decoration:none; font-size:16px;
                font-weight:700; box-shadow:0 4px 15px rgba(46,125,82,0.4);">
                Read Quran
            </a>
            <a href="/prayer"
               style="background:white; color:#2e7d52; padding:14px 30px;
                border-radius:30px; text-decoration:none; font-size:16px;
                font-weight:700; border:2px solid #2e7d52;">
                Prayer Times
            </a>
        </div>
    </div>

    <div style="flex:1; text-align:center; z-index:1;">
        <img src="/images/Quran1.png"
             style="max-width:450px; width:100%;
        filter:drop-shadow(0 20px 40px rgba(0,0,0,0.15));" />
    </div>
</div>



