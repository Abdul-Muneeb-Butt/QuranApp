@code {
    private QuranApp.Services.PrayerTimes? prayerTimes;
    private QuranApp.Services.PrayerHijriInfo? hijriDate;
    private string cityName = "Islamabad";
    private string currentPrayer = "";
    private string nextPrayerTime = "";
    private string countdown = "";
    private Timer? timer;

    protected override async Task OnInitializedAsync()
    {
        prayerTimes = await PrayerService
            .GetPrayerTimesAsync(cityName, "Pakistan");
        hijriDate = await PrayerService.GetHijriDateAsync();
        UpdateCurrentPrayer();

        timer = new Timer(1000);
        timer.Elapsed += (s, e) =>
        {
            UpdateCurrentPrayer();
            InvokeAsync(StateHasChanged);
        };
        timer.Start();
    }

    private async Task ChangeCity(ChangeEventArgs e)
    {
        cityName = e.Value?.ToString() ?? "Islamabad";
        prayerTimes = await PrayerService
            .GetPrayerTimesAsync(cityName, "Pakistan");
        UpdateCurrentPrayer();
        StateHasChanged();
    }

    private void UpdateCurrentPrayer()
    {
        if (prayerTimes == null) return;
        var now = DateTime.Now.TimeOfDay;
        var prayers = new List<(string Name, TimeSpan Time)>
        {
            ("Fajr",    ParseTime(prayerTimes.Fajr)),
            ("Dhuhr",   ParseTime(prayerTimes.Dhuhr)),
            ("Asr",     ParseTime(prayerTimes.Asr)),
            ("Maghrib", ParseTime(prayerTimes.Maghrib)),
            ("Isha",    ParseTime(prayerTimes.Isha))
        };
        var next = prayers[0];
        foreach (var prayer in prayers)
        {
            if (now < prayer.Time) { next = prayer; break; }
            next = prayers[0];
        }
        currentPrayer = next.Name;
        var nextTime = next.Time;
        if (now > nextTime) nextTime = nextTime.Add(TimeSpan.FromHours(24));
        var remaining = nextTime - now;
        nextPrayerTime = DateTime.Today.Add(next.Time).ToString("h:mm tt");
        countdown = $"{(int)remaining.TotalHours}:{remaining.Minutes:D2}:{remaining.Seconds:D2}";
    }

    private TimeSpan ParseTime(string time)
    {
        var parts = time.Split(':');
        if (parts.Length >= 2 &&
            int.TryParse(parts[0], out int h) &&
            int.TryParse(parts[1], out int m))
            return new TimeSpan(h, m, 0);
        return TimeSpan.Zero;
    }

    public void Dispose()
    {
        timer?.Stop();
        timer?.Dispose();
    }
}