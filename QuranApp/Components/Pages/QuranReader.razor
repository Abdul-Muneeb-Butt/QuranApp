@page "/quran"
@inject QuranApp.Services.QuranService QuranService
@rendermode InteractiveServer

<div class="quran-container">
    <div class="quran-header">
        Quran Reader
    </div>

    @if (surahs == null)
    {
        <p>Loading Surahs...</p>
    }
    else if (ayahs == null)
    {
        @foreach (var surah in surahs)
        {
            <div class="surah-card" @onclick="() => SelectSurah(surah.Number)">
                <div class="surah-english">
                    @surah.Number. @surah.EnglishName (@surah.NumberOfAyahs)
                </div>
                <div class="surah-arabic">
                    @surah.Name
                </div>
            </div>
        }
    }
    else
    {
        <div class="ayah-container islamic-frame">
            <div class="surah-title-frame">
                <h2 style="color:#2e7d52;">@selectedSurahName</h2>
            </div>

            

            @foreach (var ayah in ayahs)
            {
                if (ayah.NumberInSurah == 1)
                {
                    <div style="text-align:center; font-size:28px;
                        color:#2e7d52; margin-bottom:25px;
                        direction:rtl;">
                        بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ
                    </div>
                    @if (!string.IsNullOrWhiteSpace(ayah.TextWithoutBismillah))
                    {
                        <span class="ayah-text">@ayah.TextWithoutBismillah</span>
                        <span class="ayah-number">1</span>
                    }
                }
                else
                {
                    <span class="ayah-text">@ayah.Text</span>
                    <span class="ayah-number">@ayah.NumberInSurah</span>
                }
            }
        </div>
        <button @onclick="GoBack"
                style="margin:15px; background:#2e7d52; color:white;
            padding:10px 20px; border:none; border-radius:5px;">
            Back to Surahs
        </button>
    }
</div>

@code {
    private string selectedSurahName = "";
    private List<QuranApp.Services.Surah>? surahs;
    private List<QuranApp.Services.Ayah>? ayahs;
    private int selectedSurah = 0;

    protected override async Task OnInitializedAsync()
    {
        surahs = await QuranService.GetSurahsAsync();
    }

    private async Task SelectSurah(int surahNumber)
    {
        selectedSurah = surahNumber;
        selectedSurahName = surahs?.FirstOrDefault
        (s => s.Number == surahNumber)?.EnglishName ?? "";
        ayahs = await QuranService.GetAyahsAsync(surahNumber);
    }

    private void GoBack()
    {
        ayahs = null;
        selectedSurah = 0;
        selectedSurahName = "";
    }
}