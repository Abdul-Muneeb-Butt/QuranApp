@page "/qibla"
@inject QuranApp.Services.QiblaService QiblaService
@inject IJSRuntime JS
@rendermode InteractiveServer

<div style="background:#2e7d52; min-height:100vh; text-align:center; padding:20px;">

    <div style="padding:15px 20px;">
        <h2 style="color:white; margin:0; font-size:20px;">🧭 Qibla Finder</h2>
    </div>

    @if (isLoading)
    {
        <p style="color:white; margin-top:50px; font-size:18px;">
            Getting your location...
        </p>
    }
    else if (hasError)
    {
        <p style="color:#ffeb3b; margin-top:50px; font-size:16px;">
            Could not get location. Please allow location access.
        </p>
        <button @onclick="GetQibla"
                style="background:white; color:#2e7d52; border:none;
            padding:10px 25px; border-radius:5px; font-size:16px;
            cursor:pointer; margin-top:15px;">
            Try Again
        </button>
    }
    else if (qiblaDirection > 0)
    {
        @if (isAligned)
        {
            <div style="width:15px; height:15px; border-radius:50%;
                background:#f4c430; margin:0 auto 10px auto;
                box-shadow:0 0 15px #f4c430;
                animation:blink 0.5s infinite;">
            </div>
        }
        else
        {
            <div style="width:15px; height:15px; border-radius:50%;
                background:white; margin:0 auto 10px auto;">
            </div>
        }

        <div style="margin-top:10px; position:relative; display:inline-block;">

            <img src="/images/compass.png"
                 style="width:300px; height:300px;" />

            <div style="position:absolute; top:50%; left:50%;
                transform:translate(-50%, -50%) rotate(@(needleRotation)deg);
                font-size:60px; color:#f4c430;
                transition: transform 0.3s ease;">
                ▲
            </div>

            <img src="/images/kaaba.png"
                 style="position:absolute; bottom:-20px; right:-20px;
            width:60px; height:60px;
            @(isAligned ? "filter:drop-shadow(0 0 10px yellow);" : "")" />
        </div>

        <div style="color:white; font-size:24px; margin-top:40px;">
            Qibla: <span style="color:#f4c430; font-weight:bold;">
            @qiblaDirection.ToString("F1")°
        </span>
    </div>

    <div style="color:#b2dfdb; font-size:13px; margin-top:15px; padding:0 30px;">
        ⚠ Please keep your device horizontal for accurate reading
    </div>
}
</div>

<script>
    window.getLocationQibla = (dotNetRef) => {
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(
                (position) => {
                    dotNetRef.invokeMethodAsync('OnLocationReceived',
                        position.coords.latitude,
                        position.coords.longitude);
                },
                (error) => {
                    dotNetRef.invokeMethodAsync('OnLocationError');
                }
            );
        } else {
            dotNetRef.invokeMethodAsync('OnLocationError');
        }
    };

    window.startCompass = (dotNetRef) => {
        window.addEventListener('deviceorientationabsolute', (event) => {
            if (event.alpha !== null) {
                dotNetRef.invokeMethodAsync('OnDeviceRotated', event.alpha);
            }
        }, true);

        window.addEventListener('deviceorientation', (event) => {
            if (event.alpha !== null) {
                dotNetRef.invokeMethodAsync('OnDeviceRotated', event.alpha);
            }
        }, true);
    };
</script>

@code {
    private double qiblaDirection = 0;
    private bool isLoading = false;
    private bool hasError = false;
    private double deviceHeading = 0;
    private double needleRotation = 0;
    private bool isAligned = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await Task.Delay(500);
                var dotNetRef = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("getLocationQibla", dotNetRef);
            }
            catch
            {
                hasError = true;
                isLoading = false;
                StateHasChanged();
            }
        }
    }

    private async Task GetQibla()
    {
        isLoading = true;
        hasError = false;
        StateHasChanged();
        await Task.Delay(500);
        var dotNetRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("getLocationQibla", dotNetRef);
    }

    [JSInvokable]
    public async Task OnLocationReceived(double latitude, double longitude)
    {
        try
        {
            qiblaDirection = await QiblaService.GetQiblaDirectionAsync(latitude, longitude);
        }
        catch
        {
            hasError = true;
        }

        isLoading = false;
        StateHasChanged();

        var dotNetRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("startCompass", dotNetRef);
    }

    [JSInvokable]
    public void OnLocationError()
    {
        isLoading = false;
        hasError = true;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnDeviceRotated(double heading)
    {
        deviceHeading = heading;
        needleRotation = qiblaDirection - heading;
        isAligned = Math.Abs(needleRotation) < 5;
        StateHasChanged();
    }
}