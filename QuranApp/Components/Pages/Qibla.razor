@page "/qibla"
@inject QuranApp.Services.QiblaService QiblaService
@inject IJSRuntime JS
@rendermode InteractiveServer

<div style="background: linear-gradient(135deg, #1B6B3A, #2e7d52, #52b788);
    min-height:100vh; text-align:center; padding:20px;">

    <div style="padding:15px 20px;">
        <h2 style="color:white; margin:0; font-size:24px;">🧭 Qibla Finder</h2>
    </div>

    @if (isLoading)
    {
        <p style="color:white; margin-top:50px; font-size:18px;">
            Getting your location...
        </p>
    }
    else if (hasError)
    {
        <p style="color:#ffeb3b; margin-top:50px; font-size:16px;">
            Could not get location. Please allow location access.
        </p>
        <button @onclick="GetQibla"
                style="background:white; color:#2e7d52; border:none;
            padding:10px 25px; border-radius:5px; font-size:16px;
            cursor:pointer; margin-top:15px;">
            Try Again
        </button>
    }
    else if (qiblaDirection > 0)
    {
        <div style="color:white; font-size:15px; margin-bottom:20px;">
            @if (isMobile)
            {
                <span>Rotate your device to align with Kaaba 🕋</span>
            }
            else
            {
                <span>
                    Face <b style="color:#f4c430;">
                    @qiblaDirection.ToString("F1")°
                </b> direction for Qibla 🕋
            </span>
        }
    </div>

    @* CSS Compass *@
    <div style="margin-top:30px; position:relative;
        display:inline-block; width:300px; height:300px;">

        @* Outer compass ring *@
        <div style="width:300px; height:300px; border-radius:50%;
            background: conic-gradient(#1a3a2a, #2e7d52,
            #1a3a2a, #2e7d52, #1a3a2a);
            position:absolute; top:0; left:0;
            box-shadow: 0 0 30px rgba(0,0,0,0.5),
            inset 0 0 20px rgba(0,0,0,0.3);">
        </div>

        @* Inner compass face *@
        <div style="width:260px; height:260px; border-radius:50%;
            background: radial-gradient(circle, #1c1c1c, #2d2d2d);
            position:absolute; top:20px; left:20px;
            box-shadow: inset 0 0 20px rgba(0,0,0,0.8);">
        </div>

        @* N S E W labels *@
        <div style="position:absolute; top:25px; left:50%;
            transform:translateX(-50%);
            color:#f4c430; font-size:18px;
            font-weight:bold; z-index:10;">
            N
        </div>
        <div style="position:absolute; bottom:25px; left:50%;
            transform:translateX(-50%);
            color:white; font-size:18px;
            font-weight:bold; z-index:10;">
            S
        </div>
        <div style="position:absolute; right:25px; top:50%;
            transform:translateY(-50%);
            color:white; font-size:18px;
            font-weight:bold; z-index:10;">
            E
        </div>
        <div style="position:absolute; left:25px; top:50%;
            transform:translateY(-50%);
            color:white; font-size:18px;
            font-weight:bold; z-index:10;">
            W
        </div>

        @* Needle - rotates to Qibla direction *@
        <div style="position:absolute; top:50%; left:50%;
            width:8px; height:130px;
            transform:translate(-50%, -100%)
            rotate(@(isMobile ? needleRotation : qiblaDirection)deg);
            transform-origin: bottom center;
            transition: transform 0.3s ease;
            z-index:20;">

            @* Top part - points to Qibla *@
            <div style="width:8px; height:80px;
                background: linear-gradient(to top, #f4c430, #ff9800);
                border-radius:4px 4px 0 0;
                position:relative;">
                <div style="position:absolute; top:-25px; left:50%;
                    transform:translateX(-50%);
                    font-size:20px;">
                    🕋
                </div>
            </div>

            @* Bottom part - points opposite *@
            <div style="width:8px; height:50px;
                background: linear-gradient(to bottom, #e53935, #b71c1c);
                border-radius:0 0 4px 4px;">
            </div>
        </div>

        @* Center dot *@
        <div style="position:absolute; top:50%; left:50%;
            transform:translate(-50%, -50%);
            width:16px; height:16px; border-radius:50%;
            background:#f4c430;
            box-shadow: 0 0 8px #f4c430;
            z-index:30;">
        </div>

    </div>

    <div style="color:white; font-size:22px; margin-top:40px;">
        Qibla Direction:
        <span style="color:#f4c430; font-weight:bold;">
            @qiblaDirection.ToString("F1")°
        </span>
    </div>

    @if (isMobile)
    {
        <div style="color:#b2dfdb; font-size:13px;
            margin-top:10px; padding:0 30px;">
            ⚠ Keep device horizontal for accurate reading
        </div>
    }
    else
    {
        <div style="background:rgba(0,0,0,0.2); border-radius:10px;
            padding:15px; margin:15px 30px;
            color:white; font-size:14px;">
            💻 For live compass rotation please use a mobile device.
            The Qibla angle shown is accurate for your location.
        </div>
    }
}
</div>

<script>
    window.getLocationQibla = (dotNetRef) => {
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(
                (position) => {
                    dotNetRef.invokeMethodAsync('OnLocationReceived',
                        position.coords.latitude,
                        position.coords.longitude);
                },
                (error) => {
                    dotNetRef.invokeMethodAsync('OnLocationError');
                }
            );
        } else {
            dotNetRef.invokeMethodAsync('OnLocationError');
        }
    };

    window.startCompass = (dotNetRef) => {
        window.addEventListener('deviceorientationabsolute', (event) => {
            if (event.alpha !== null) {
                dotNetRef.invokeMethodAsync('OnDeviceRotated', event.alpha);
            }
        }, true);
        window.addEventListener('deviceorientation', (event) => {
            if (event.alpha !== null) {
                dotNetRef.invokeMethodAsync('OnDeviceRotated', event.alpha);
            }
        }, true);
    };

    window.checkMobile = () => {
        return /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
    };
</script>

@code {
    private double qiblaDirection = 0;
    private bool isLoading = false;
    private bool hasError = false;
    private double deviceHeading = 0;
    private double needleRotation = 0;
    private bool isAligned = false;
    private bool isMobile = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                isMobile = await JS.InvokeAsync<bool>("checkMobile");
                await Task.Delay(500);
                var dotNetRef = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("getLocationQibla", dotNetRef);
            }
            catch
            {
                hasError = true;
                isLoading = false;
                StateHasChanged();
            }
        }
    }

    private async Task GetQibla()
    {
        isLoading = true;
        hasError = false;
        StateHasChanged();
        await Task.Delay(500);
        var dotNetRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("getLocationQibla", dotNetRef);
    }

    [JSInvokable]
    public async Task OnLocationReceived(double latitude, double longitude)
    {
        try
        {
            qiblaDirection = await QiblaService
                .GetQiblaDirectionAsync(latitude, longitude);
        }
        catch
        {
            hasError = true;
        }

        isLoading = false;
        StateHasChanged();

        if (isMobile)
        {
            var dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("startCompass", dotNetRef);
        }
    }

    [JSInvokable]
    public void OnLocationError()
    {
        isLoading = false;
        hasError = true;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnDeviceRotated(double heading)
    {
        deviceHeading = heading;
        needleRotation = qiblaDirection - heading;
        isAligned = Math.Abs(needleRotation) < 5;
        StateHasChanged();
    }
}