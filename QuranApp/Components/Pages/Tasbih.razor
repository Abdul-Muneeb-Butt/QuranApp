@page "/tasbih"
@rendermode InteractiveServer

<div style="background:linear-gradient(135deg, #1a5c38 0%, #2e7d52 50%, #1a5c38 100%);
    min-height:100vh; display:flex; flex-direction:column; align-items:center;">

    <div style="width:100%; padding:15px 20px; text-align:center;">
        <h2 style="color:white; margin:0; font-size:22px; letter-spacing:2px;">
            📿 Tasbih Counter
        </h2>
    </div>

    <div style="background:rgba(255,255,255,0.1); border-radius:15px;
        padding:15px; margin:10px; width:90%; max-width:400px;">
        <div style="text-align:center; direction:rtl;
            font-family:'Amiri', serif; font-size:28px;
            color:white; margin-bottom:5px;">
            @tasbeehOptions[selectedIndex].Arabic
        </div>
        <div style="text-align:center; color:rgba(255,255,255,0.8); font-size:14px;">
            @tasbeehOptions[selectedIndex].Meaning
        </div>
    </div>

    <div style="position:relative; margin:20px 0;">
        <div style="width:200px; height:200px; border-radius:50%;
            background:rgba(255,255,255,0.15);
            display:flex; align-items:center; justify-content:center;
            box-shadow:0 0 0 15px rgba(255,255,255,0.05),
            0 0 0 30px rgba(255,255,255,0.03);">
            <div style="width:160px; height:160px; border-radius:50%;
                background:rgba(255,255,255,0.2);
                display:flex; align-items:center; justify-content:center;">
                <div style="text-align:center;">
                    <div style="font-size:64px; font-weight:bold; color:white;
                        line-height:1;">
                        @count
                    </div>
                    <div style="color:rgba(255,255,255,0.7); font-size:13px;">
                        / @tasbeehOptions[selectedIndex].Target
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (count == tasbeehOptions[selectedIndex].Target)
    {
        <div style="background:rgba(244,196,48,0.2); border:1px solid #f4c430;
            border-radius:10px; padding:10px 20px; margin:10px;
            text-align:center; color:#f4c430; font-size:15px;">
            🎉 @tasbeehOptions[selectedIndex].Target completed! Masha Allah!
        </div>
    }

    <button @onclick="Increment"
            style="width:90px; height:90px; border-radius:50%;
        background:white; color:#2e7d52; border:none;
        font-size:40px; cursor:pointer; margin:10px;
        box-shadow:0 8px 20px rgba(0,0,0,0.3);
        font-weight:bold;">
        +
    </button>

    <div style="display:flex; gap:15px; margin:10px;">
        <button @onclick="Reset"
                style="background:rgba(198,40,40,0.8); color:white;
            border:none; padding:10px 25px; border-radius:25px;
            font-size:15px; cursor:pointer;">
            🔄 Reset
        </button>
        <button @onclick="ResetAll"
                style="background:rgba(255,255,255,0.2); color:white;
            border:1px solid rgba(255,255,255,0.5);
            padding:10px 25px; border-radius:25px;
            font-size:15px; cursor:pointer;">
            ↺ New
        </button>
    </div>

    <div style="width:90%; max-width:400px; margin:15px 0;">
        <div style="background:rgba(255,255,255,0.1); border-radius:10px;
            height:6px; overflow:hidden; margin-bottom:5px;">
            <div style="background:#f4c430; height:100%; border-radius:10px;
                width:@(Math.Min(100, (count * 100.0 / tasbeehOptions[selectedIndex].Target)).ToString("F0"))%;
                transition:width 0.3s ease;">
            </div>
        </div>
        <div style="text-align:center; color:rgba(255,255,255,0.7); font-size:12px;">
            @(Math.Min(100, (count * 100.0 / tasbeehOptions[selectedIndex].Target)).ToString("F0"))% completed
        </div>
    </div>

    <div style="width:90%; max-width:400px; margin:10px 0;">
        <p style="color:rgba(255,255,255,0.8); font-size:13px;
            text-align:center; margin-bottom:10px;">
            Select Dhikr:
        </p>
        <div style="display:flex; flex-wrap:wrap; gap:8px; justify-content:center;">
            @for (int i = 0; i < tasbeehOptions.Count; i++)
            {
                var index = i;
                <button @onclick="() => SelectDhikr(index)"
                        style="background:@(selectedIndex == index ? "white" : "rgba(255,255,255,0.15)");
                    color:@(selectedIndex == index ? "#2e7d52" : "white");
                    border:1px solid rgba(255,255,255,0.4);
                    padding:8px 15px; border-radius:20px;
                    cursor:pointer; font-size:13px; font-weight:bold;">
                    @tasbeehOptions[index].Name
                </button>
            }
        </div>
    </div>

    <div style="width:90%; max-width:400px; margin:10px 0;
        background:rgba(255,255,255,0.1); border-radius:10px; padding:15px;">
        <p style="color:rgba(255,255,255,0.9); font-size:13px;
            text-align:center; margin:0;">
            Total Today: <b style="color:#f4c430; font-size:18px;">@totalCount</b> dhikr
        </p>
    </div>

</div>

@code {
    private int count = 0;
    private int totalCount = 0;
    private int selectedIndex = 0;

    private List<TasbeehItem> tasbeehOptions = new()
    {
        new TasbeehItem { Name = "Subhanallah", Arabic = "سُبْحَانَ اللَّهِ",
            Meaning = "Glory be to Allah", Target = 33 },
        new TasbeehItem { Name = "Alhamdulillah", Arabic = "الْحَمْدُ لِلَّهِ",
            Meaning = "All praise is due to Allah", Target = 33 },
        new TasbeehItem { Name = "Allahu Akbar", Arabic = "اللَّهُ أَكْبَرُ",
            Meaning = "Allah is the Greatest", Target = 34 },
        new TasbeehItem { Name = "Astaghfirullah", Arabic = "أَسْتَغْفِرُ اللَّهَ",
            Meaning = "I seek forgiveness from Allah", Target = 100 },
        new TasbeehItem { Name = "La ilaha illallah", Arabic = "لَا إِلَهَ إِلَّا اللَّهُ",
            Meaning = "There is no god but Allah", Target = 100 }
    };

    private void Increment()
    {
        count++;
        totalCount++;
    }

    private void Reset()
    {
        count = 0;
    }

    private void ResetAll()
    {
        count = 0;
        totalCount = 0;
    }

    private void SelectDhikr(int index)
    {
        selectedIndex = index;
        count = 0;
    }

    private class TasbeehItem
    {
        public string Name { get; set; } = "";
        public string Arabic { get; set; } = "";
        public string Meaning { get; set; } = "";
        public int Target { get; set; } = 33;
    }
}