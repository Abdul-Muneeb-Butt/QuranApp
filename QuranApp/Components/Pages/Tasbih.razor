@page "/tasbih"
@rendermode InteractiveServer

<div class="quran-container">
    <div class="quran-header">
        Tasbih Counter
    </div>

    <div style="text-align:center; padding:40px 20px;">

        <div style="font-size:22px; color:#2e7d52; margin-bottom:10px;">
            @tasbeehOptions[selectedIndex].Arabic
        </div>
        <div style="font-size:16px; color:#5d4037; margin-bottom:30px;">
            @tasbeehOptions[selectedIndex].Meaning
        </div>

        <div style="font-size:100px; font-weight:bold; color:#2e7d52; margin-bottom:20px;">
            @count
        </div>

        <div style="margin-bottom:20px;">
            <button @onclick="Increment"
                    style="background:#2e7d52; color:white; border:none;
                width:120px; height:120px; border-radius:50%;
                font-size:40px; cursor:pointer; box-shadow:0 4px 8px rgba(0,0,0,0.2);">
                +
            </button>
        </div>

        <div style="margin-bottom:30px;">
            <button @onclick="Reset"
                    style="background:#c62828; color:white; border:none;
                padding:10px 30px; border-radius:5px;
                font-size:16px; cursor:pointer;">
                Reset
            </button>
        </div>

        <div style="margin-bottom:20px;">
            <p style="color:#5d4037; font-size:16px;">Select Dhikr:</p>
            @for (int i = 0; i < tasbeehOptions.Count; i++)
            {
                var index = i;
                <button @onclick="() => SelectDhikr(index)"
                        style="background:@(selectedIndex == index ? "#2e7d52" : "#f5f0e8");
                    color:@(selectedIndex == index ? "white" : "#2e7d52");
                    border:1px solid #2e7d52; padding:8px 15px;
                    border-radius:5px; margin:5px; cursor:pointer; font-size:14px;">
                    @tasbeehOptions[index].Name
                </button>
            }
        </div>

        @if (count == 33)
        {
            <div style="background:#e8f5e9; border:1px solid #2e7d52;
                border-radius:8px; padding:15px; margin-top:10px;">
                <p style="color:#2e7d52; font-size:16px; margin:0;">
                    ✅ 33 completed! Masha Allah!
                </p>
            </div>
        }
        @if (count == 99)
        {
            <div style="background:#e8f5e9; border:1px solid #2e7d52;
                border-radius:8px; padding:15px; margin-top:10px;">
                <p style="color:#2e7d52; font-size:18px; margin:0;">
                    🎉 99 completed! Alhamdulillah!
                </p>
            </div>
        }

    </div>
</div>

@code {
    private int count = 0;
    private int selectedIndex = 0;

    private List<TasbeehItem> tasbeehOptions = new()
    {
        new TasbeehItem { Name = "Subhanallah", Arabic = "سُبْحَانَ اللَّهِ", Meaning = "Glory be to Allah" },
        new TasbeehItem { Name = "Alhamdulillah", Arabic = "الْحَمْدُ لِلَّهِ", Meaning = "All praise is due to Allah" },
        new TasbeehItem { Name = "Allahu Akbar", Arabic = "اللَّهُ أَكْبَرُ", Meaning = "Allah is the Greatest" },
        new TasbeehItem { Name = "Astaghfirullah", Arabic = "أَسْتَغْفِرُ اللَّهَ", Meaning = "I seek forgiveness from Allah" },
        new TasbeehItem { Name = "La ilaha illallah", Arabic = "لَا إِلَهَ إِلَّا اللَّهُ", Meaning = "There is no god but Allah" }
    };

    private void Increment()
    {
        count++;
    }

    private void Reset()
    {
        count = 0;
    }

    private void SelectDhikr(int index)
    {
        selectedIndex = index;
        count = 0;
    }

    private class TasbeehItem
    {
        public string Name { get; set; } = "";
        public string Arabic { get; set; } = "";
        public string Meaning { get; set; } = "";
    }
}