@page "/asmaulhusna"
@rendermode InteractiveServer

<div style="background:#2e7d52; padding:15px 20px;">
 
    <h2 style="color:white; margin:0; font-size:20px;"> 99 Names of Allah</h2>
</div>
<div style="background:#f5f0e8; min-height:100vh; padding:10px;">
    @foreach (var name in AllahNames)
    {
        <div style="background:#fdf6e3; margin:8px 0; padding:15px;
            display:flex; align-items:center; gap:10px;
            position:relative;
            border:1px solid #c8a96e;">

            @* Top left corner *@
            <div style="position:absolute; top:-2px; left:-2px;
                color:#c8a96e; font-size:16px; line-height:1;">
                ❧
            </div>
            @* Top right corner *@
            <div style="position:absolute; top:-2px; right:-2px;
                color:#c8a96e; font-size:16px; line-height:1;">
                ❧
            </div>
            @* Bottom left corner *@
            <div style="position:absolute; bottom:-2px; left:-2px;
                color:#c8a96e; font-size:16px; line-height:1;">
                ❧
            </div>
            @* Bottom right corner *@
            <div style="position:absolute; bottom:-2px; right:-2px;
                color:#c8a96e; font-size:16px; line-height:1;">
                ❧
            </div>

            <div style="color:#8B6914; font-size:16px; font-weight:bold;
                min-width:35px; text-align:center;">
                @name.Number.
            </div>

            <div style="flex:1;">
                <div style="color:#5d3a00; font-size:18px; font-weight:bold;">
                    @name.English
                </div>
                <div style="color:#8B6914; font-size:13px; margin-top:3px;">
                    @name.Meaning
                </div>
            </div>

            <div style="color:#8B6914; font-size:32px;
                font-family:'Amiri', serif;
                text-align:right; min-width:80px;">
                @name.Arabic
            </div>
        </div>
    }
</div>
@code {
    private class AllahName
    {
        public int Number { get; set; }
        public string English { get; set; } = "";
        public string Arabic { get; set; } = "";
        public string Meaning { get; set; } = "";
    }

    private List<AllahName> AllahNames = new()
    {
        new AllahName { Number = 1, English = "Ar-Rahman", Arabic = "الرَّحْمَنُ", Meaning = "The Exceedingly Compassionate, The Exceedingly Beneficent" },
        new AllahName { Number = 2, English = "Ar-Raheem", Arabic = "الرَّحِيمُ", Meaning = "The Most Merciful" },
        new AllahName { Number = 3, English = "Al-Malik", Arabic = "الْمَلِكُ", Meaning = "The King" },
        new AllahName { Number = 4, English = "Al-Quddus", Arabic = "الْقُدُّوسُ", Meaning = "The Most Holy" },
        
        // Qasim add remaining 98 names here same pattern
        
    };

}
