@page "/bookmarks"
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@rendermode InteractiveServer

<div style="min-height:100vh; background:#f5f5f5; padding-bottom:80px;">

    @* Header *@
    <div style="background:#2e7d52; padding:20px; text-align:center;">
        <h2 style="color:white; margin:0;">🔖 My Bookmarks</h2>
    </div>

    <div style="padding:15px;">

        @if (bookmarks == null)
        {
            <p style="text-align:center; color:#888; margin-top:50px;">
                Loading...
            </p>
        }
        else if (bookmarks.Count == 0)
        {
            <div style="text-align:center; margin-top:80px;">
                <div style="font-size:60px;">🔖</div>
                <p style="color:#888; font-size:16px; margin-top:15px;">
                    No bookmarks yet!
                </p>
                <p style="color:#aaa; font-size:14px;">
                    Go to Quran Reader and bookmark your favourite Ayahs
                </p>
                <a href="/quran"
                       style="display:inline-block; margin-top:20px;
                    background:#2e7d52; color:white; padding:12px 25px;
                    border-radius:8px; text-decoration:none; font-size:15px;">
                    Open Quran Reader
                </a>
            </div>
        }
        else
        {
            <p style="color:#888; font-size:13px; margin-bottom:15px;">
                @bookmarks.Count bookmark(s) saved
            </p>

            @foreach (var bookmark in bookmarks)
            {
                <div style="background:white; border-radius:12px;
                    padding:15px; margin-bottom:12px;
                    box-shadow:0 2px 8px rgba(0,0,0,0.08);
                    border-left:4px solid #2e7d52;">

                    @* Surah Info *@
                    <div style="display:flex; justify-content:space-between;
                        align-items:center; margin-bottom:8px;">
                        <span style="background:#2e7d52; color:white;
                            padding:3px 10px; border-radius:20px;
                            font-size:12px;">
                            @bookmark.SurahName — Ayah @bookmark.AyahNumber
                        </span>
                        <button @onclick="() => RemoveBookmark(bookmark.Id)"
                                style="background:none; border:none;
                            color:#e53935; font-size:18px;
                            cursor:pointer;">
                            🗑
                        </button>
                    </div>

                    @* Arabic Text *@
                    <p style="font-size:20px; color:#3e2723;
                        direction:rtl; text-align:right;
                        font-family:'Traditional Arabic', serif;
                        line-height:2; margin:8px 0;">
                        @bookmark.ArabicText
                    </p>

                    @* Go to Ayah *@
                    <a href="/quran"
                           style="color:#2e7d52; font-size:13px;
                        text-decoration:none;">
                        → Open in Quran Reader
                    </a>
                </div>
            }

            @* Clear All Button *@
            <button @onclick="ClearAll"
                    style="width:100%; padding:12px; background:#e53935;
                color:white; border:none; border-radius:8px;
                font-size:15px; cursor:pointer; margin-top:10px;">
                Clear All Bookmarks
            </button>
        }
    </div>
</div>

@code {
    private List<BookmarkItem>? bookmarks;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadBookmarks();
        }
    }

    private async Task LoadBookmarks()
    {
        bookmarks = await LocalStorage
            .GetItemAsync<List<BookmarkItem>>("bookmarks")
            ?? new List<BookmarkItem>();
        StateHasChanged();
    }

    private async Task RemoveBookmark(string id)
    {
        bookmarks?.RemoveAll(b => b.Id == id);
        await LocalStorage.SetItemAsync("bookmarks", bookmarks);
        StateHasChanged();
    }

    private async Task ClearAll()
    {
        bookmarks = new List<BookmarkItem>();
        await LocalStorage.RemoveItemAsync("bookmarks");
        StateHasChanged();
    }

    public class BookmarkItem
    {
        public string Id { get; set; } = "";
        public string SurahName { get; set; } = "";
        public int AyahNumber { get; set; }
        public string ArabicText { get; set; } = "";
    }
}