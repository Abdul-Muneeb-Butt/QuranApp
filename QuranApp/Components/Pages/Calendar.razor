@page "/calendar"
@using QuranApp.Services
@inject CalendarService CalendarService
@rendermode InteractiveServer

<div style="background:#2e7d52; min-height:100vh;">

    <div style="background:#2e7d52; padding:15px 20px;">
        <h2 style="color:white; margin:0; font-size:20px;">📅 Islamic Calendar</h2>
    </div>

    <div style="display:flex; background:#2e7d52; border-bottom:2px solid rgba(255,255,255,0.3);">
        <div @onclick='() => SwitchTab(true)'
             style="flex:1; padding:12px; text-align:center; cursor:pointer;
            color:white; font-size:16px;
            border-bottom:@(showHijri ? "3px solid #f4c430" : "none");">
            Hijri
        </div>
        <div @onclick='() => SwitchTab(false)'
             style="flex:1; padding:12px; text-align:center; cursor:pointer;
            color:white; font-size:16px;
            border-bottom:@(!showHijri ? "3px solid #f4c430" : "none");">
            Gregorian
        </div>
    </div>

    <div style="display:flex; align-items:center; justify-content:space-between;
        padding:15px 20px; background:#2e7d52;">
        <button @onclick="PreviousMonth"
                style="background:none; border:none; color:white;
            font-size:24px; cursor:pointer;">
            ◀
        </button>
        <span style="color:white; font-size:16px; font-weight:bold;">
            @GetMonthTitle()
        </span>
        <button @onclick="NextMonth"
                style="background:none; border:none; color:white;
            font-size:24px; cursor:pointer;">
            ▶
        </button>
    </div>

    <div style="background:#2e7d52; margin:0; padding:10px;">

        <div style="display:grid; grid-template-columns:repeat(7,1fr);
            text-align:center; margin-bottom:5px;">
            @foreach (var d in new[] { "S", "M", "T", "W", "T", "F", "S" })
            {
                <div style="color:white; font-weight:bold; padding:5px;">
                    @d
                </div>
            }
        </div>

        @if (isLoading)
        {
            <p style="text-align:center; padding:20px; color:white;">
                Loading...
            </p>
        }
        else if (calendarDays != null)
        {
            <div style="display:grid; grid-template-columns:repeat(7,1fr);
                text-align:center;">

                @{
                    var firstDay = calendarDays.FirstOrDefault();
                    int offset = 0;
                    if (firstDay?.Gregorian?.Weekday?.En != null)
                    {
                        var weekdays = new[] { "Sunday","Monday","Tuesday",
                            "Wednesday","Thursday","Friday","Saturday" };
                        offset = Array.IndexOf(weekdays,
                            firstDay.Gregorian.Weekday.En);
                        if (offset < 0) offset = 0;
                    }
                    for (int i = 0; i < offset; i++)
                    {
                        <div></div>
                    }
                }

                @foreach (var day in calendarDays)
                {
                    bool isToday = IsToday(day);
                    string? dayNum = showHijri ? day.Hijri?.Day : day.Gregorian?.Day;
                    bool hasEvent = day.Hijri?.Holidays?
                        .Any(h => !string.IsNullOrEmpty(h)) ?? false;

                    <div style="padding:5px; position:relative;">
                        <div style="width:32px; height:32px; border-radius:50%;
                            margin:0 auto;
                            background:@(isToday ? "white" : "transparent");
                            color:@(isToday ? "#2e7d52" : "white");
                            display:flex; align-items:center;
                            justify-content:center; font-size:14px;
                            font-weight:@(isToday ? "bold" : "normal");">
                            @dayNum
                        </div>
                        @if (hasEvent)
                        {
                            <div style="width:6px; height:6px; border-radius:50%;
                                background:#f4c430; margin:2px auto 0 auto;">
                            </div>
                        }
                    </div>
                }
            </div>
        }

        <div style="text-align:center; padding:10px;
            border-top:1px solid rgba(255,255,255,0.3); margin-top:10px;">
            <span style="color:white; font-size:13px; letter-spacing:2px;">TODAY</span>
        </div>
    </div>

    <div style="background:white; margin-top:8px; padding:10px;">
        @foreach (var ev in islamicEvents)
        {
            <div style="display:flex; justify-content:space-between;
                align-items:center; padding:15px 10px;
                border-bottom:1px solid #eee;">
                <div>
                    <div style="color:#333; font-size:16px; font-weight:500;">
                        @ev.Name
                    </div>
                    <div style="color:#888; font-size:12px;">
                        @ev.HijriDate
                    </div>
                </div>
                <div style="color:#2e7d52; font-size:14px; font-weight:bold;">
                    @ev.GregorianDate
                </div>
            </div>
        }
    </div>

</div>

@code {
    private bool showHijri = true;
    private int currentMonth = DateTime.Now.Month;
    private int currentYear = DateTime.Now.Year;
    private int currentHijriMonth = 11;
    private int currentHijriYear = 1447;
    private List<CalendarDay>? calendarDays;
    private bool isLoading = false;

    private List<(string Name, string HijriDate, string GregorianDate)> islamicEvents = new()
    {
        ("Hajj", "12/8/1447H", "5/25/2026"),
        ("Eid al-Adha", "12/10/1447H", "5/27/2026"),
        ("Al-Hijira", "1/1/1448H", "6/16/2026"),
        ("Ashura", "1/10/1448H", "6/25/2026"),
        ("Eid Milad un Nabi", "3/12/1448H", "9/4/2026"),
        ("Ramadan Start", "1/1/1449H", "3/17/2027"),
        ("Eid ul Fitr", "1/10/1449H", "3/27/2027"),
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentHijriDate();
        await LoadCalendar();
    }

    private async Task LoadCurrentHijriDate()
    {
        try
        {
            var days = await CalendarService.GetGregorianMonthAsync(
                DateTime.Now.Month, DateTime.Now.Year);
            var today = days?.FirstOrDefault(d =>
                d.Gregorian?.Day == DateTime.Now.Day.ToString());
            if (today?.Hijri?.Month != null)
            {
                currentHijriMonth = today.Hijri.Month.Number;
                currentHijriYear = int.TryParse(
                    today.Hijri.Year, out int y) ? y : 1447;
            }
        }
        catch { }
    }

    private async Task LoadCalendar()
    {
        isLoading = true;
        StateHasChanged();
        try
        {
            if (showHijri)
            {
                calendarDays = await CalendarService.GetHijriMonthAsync(
                    currentHijriMonth, currentHijriYear);
            }
            else
            {
                calendarDays = await CalendarService.GetGregorianMonthAsync(
                    currentMonth, currentYear);
            }
        }
        catch { }
        isLoading = false;
        StateHasChanged();
    }

    private async Task PreviousMonth()
    {
        if (showHijri)
        {
            currentHijriMonth--;
            if (currentHijriMonth < 1)
            {
                currentHijriMonth = 12;
                currentHijriYear--;
            }
        }
        else
        {
            currentMonth--;
            if (currentMonth < 1)
            {
                currentMonth = 12;
                currentYear--;
            }
        }
        await LoadCalendar();
    }

    private async Task NextMonth()
    {
        if (showHijri)
        {
            currentHijriMonth++;
            if (currentHijriMonth > 12)
            {
                currentHijriMonth = 1;
                currentHijriYear++;
            }
        }
        else
        {
            currentMonth++;
            if (currentMonth > 12)
            {
                currentMonth = 1;
                currentYear++;
            }
        }
        await LoadCalendar();
    }

    private async Task SwitchTab(bool hijri)
    {
        showHijri = hijri;
        await LoadCalendar();
    }

    private bool IsToday(CalendarDay day)
    {
        return day.Gregorian?.Day == DateTime.Now.Day.ToString() &&
               day.Gregorian?.Month?.Number == DateTime.Now.Month &&
               day.Gregorian?.Year == DateTime.Now.Year.ToString();
    }

    private string GetMonthTitle()
    {
        if (showHijri)
        {
            var monthNames = new[] { "", "Muharram", "Safar",
                "Rabi al-Awwal", "Rabi al-Thani",
                "Jumada al-Awwal", "Jumada al-Thani",
                "Rajab", "Sha'ban", "Ramadan", "Shawwal",
                "Dhu al-Qi'dah", "Dhu al-Hijjah" };
            return $"{monthNames[currentHijriMonth]} {currentHijriYear} AH";
        }
        else
        {
            return new DateTime(currentYear, currentMonth, 1)
                .ToString("MMMM yyyy");
        }
    }
}