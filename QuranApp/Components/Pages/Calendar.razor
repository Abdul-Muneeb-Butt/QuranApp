@page "/calendar"
@inject QuranApp.Services.CalendarService CalendarService
@rendermode InteractiveServer


@code {
    private bool showHijri = true;
    private int currentMonth = DateTime.Now.Month;
    private int currentYear = DateTime.Now.Year;
    private int currentHijriMonth = 0;
    private int currentHijriYear = 0;
    private List<QuranApp.Services.CalendarDay>? calendarDays;
    private bool isLoading = false;

    private List<(string Name, string HijriDate, string GregorianDate)> islamicEvents = new()
    {
        ("Hajj", "12/8/1447H", "5/25/2026"),
        ("Eid al-Adha", "12/10/1447H", "5/27/2026"),
        ("Al-Hijira", "1/1/1448H", "6/16/2026"),
        ("Ashura", "1/10/1448H", "6/25/2026"),
        ("Eid Milad un Nabi", "3/12/1448H", "9/4/2026"),
        ("Ramadan Start", "1/1/1449H", "3/17/2027"),
        ("Eid ul Fitr", "1/10/1449H", "3/27/2027"),
    };
    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentHijriDate();
        await LoadCalendar();
    }
    private async Task LoadCurrentHijriDate()
    {
        var days = await CalendarService.GetGregorianMonthAsync(
            DateTime.Now.Month, DateTime.Now.Year);
        var today = days?.FirstOrDefault(d =>
            d.Gregorian?.Day == DateTime.Now.Day.ToString());
        if (today?.Hijri != null)
        {
            currentHijriMonth = today.Hijri.Month?.Number ?? 1;
            currentHijriYear = int.TryParse(today.Hijri.Year, out int y) ? y : 1447;
        }
    }
    private async Task LoadCalendar()
    {
        isLoading = true;
        if (showHijri)
        {
            calendarDays = await CalendarService.GetHijriMonthAsync(
                currentHijriMonth, currentHijriYear);
        }
        else
        {
            calendarDays = await CalendarService.GetGregorianMonthAsync(
                currentMonth, currentYear);
        }
        isLoading = false;
    }

    private async Task PreviousMonth()
    {
        if (showHijri)
        {
            currentHijriMonth--;
            if (currentHijriMonth < 1) { currentHijriMonth = 12; currentHijriYear--; }
        }
        else
        {
            currentMonth--;
            if (currentMonth < 1) { currentMonth = 12; currentYear--; }
        }
        await LoadCalendar();
    }

    private async Task NextMonth()
    {
        if (showHijri)
        {
            currentHijriMonth++;
            if (currentHijriMonth > 12) { currentHijriMonth = 1; currentHijriYear++; }
        }
        else
        {
            currentMonth++;
            if (currentMonth > 12) { currentMonth = 1; currentYear++; }
        }
        await LoadCalendar();
    }

    private async Task SwitchTab(bool hijri)
    {
        showHijri = hijri;
        await LoadCalendar();
    }